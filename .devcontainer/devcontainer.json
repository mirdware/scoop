{
    "name": "Simple Charectiristics of PHP Oriented Object",
    "dockerComposeFile": "docker-compose.yml",
    "service": "webapp",
    "overrideCommand": false,
    "forwardPorts": [8000],
    "workspaceFolder": "/app",
    "shutdownAction": "stopCompose",
    "postCreateCommand": "bun install --frozen-lockfile && composer install",
    "postStartCommand": "php app/ice dbup",
    "postAttachCommand": "PHP_HOST=http://127.0.0.1:8002 bun concurrently --names vite,php \"vite\" \"frankenphp run --config /etc/caddy/Caddyfile --adapter caddyfile\"",
    "customizations": {
        "vscode": {
            "extensions": [
                "devsense.intelli-php-vscode",
                "devsense.phptools-vscode",
                "devsense.profiler-php-vscode",
                "devsense.composer-php-vscode",
                "humao.rest-client",
                "eamodio.gitlens",
                "ms-azuretools.vscode-docker",
                "sanderronde.phpstan-vscode"
            ],
            "settings": {
                "phpstan.configFile": "app/phpstan.neon"
            }
        }
    }
}
