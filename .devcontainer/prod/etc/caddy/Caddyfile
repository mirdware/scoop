{
	admin off
	persist_config off
	log default {
		exclude frankenphp
		output stderr
		format json
		level WARN
	}
	log php {
		include frankenphp
		output stderr
		format json
		level INFO
	}
	frankenphp
}

{$SERVER_NAME::80} {
	log {
		output stderr
		format json
		level WARN
	}
	import /etc/caddy/scoop.caddy
}

http://:8001 {
	bind 127.0.0.1
	import /etc/caddy/scoop.caddy
}
