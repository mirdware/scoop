#!/usr/bin/env php
<?php

$script = isset($_SERVER['SCRIPT_FILENAME']) ? $_SERVER['SCRIPT_FILENAME'] : '';
$contextFile = getenv('ICE_CONTEXT');
if (php_sapi_name() !== 'cli' && realpath($script) !== __FILE__) {
    return;
}

function dispatchEvent($dispatcher, $event) {
    try {
        $dispatcher->dispatch($event);
    } catch (\Exception $ex) {
        error_log($ex);
    } catch (\Throwable $ex) {
        error_log($ex);
    }
}

function manageError($writer, $trace, $ex) {
    $code = intval($ex->getCode());
    $writer->withError()->write('<danger:[ERROR]!> <error:' . $ex->getMessage() . ($trace ? PHP_EOL . $ex->getTraceAsString() : '') . '!>');
    return $code ? $code : 1;
}

require 'scoop/Bootstrap/Application.php';
$app = new \Scoop\Bootstrap\Application($contextFile ? $contextFile : 'app/context');
array_shift($argv);
$commandName = array_shift($argv);
$trace = $commandName === '--trace';
if ($trace) {
    $commandName = array_shift($argv);
}
$writer = $app->inject('\Scoop\Command\Writer');
$commandBus = $app->inject('\Scoop\Command\Bus');
$exitCode = 0;
if ($commandName !== null && preg_match('/^[a-zA-Z]/', $commandName)) {
    $dispatcher = $app->inject('Scoop\Event\Dispatcher');
    $error = null;
    dispatchEvent($dispatcher, new \Scoop\Command\Event\ExecutionStarted($commandName, $argv));
    try {
        $commandBus->dispatch($commandName, $argv);
    } catch (Exception $ex) {
        $error = $ex;
        $exitCode = manageError($writer, $trace, $ex);
    } catch (\Throwable $ex) {
        $error = $ex;
        $exitCode = manageError($writer, $trace, $ex);
    }
    dispatchEvent($dispatcher, new \Scoop\Command\Event\ExecutionFinished($commandName, $argv, $exitCode, $error));
} else {
    $commands = $commandBus->getCommands();
    $writer->write(
        'ICE/SCOOP version 0.9.0',
        '',
        'Commands:'
    );
    $maxlength = max(array_map('strlen', array_keys($commands)));
    foreach ($commands as $command => $controller) {
        $command = str_pad($command, $maxlength);
        $writer->write("$command => <link:$controller.php!>");
    }
    $writer->write(
        '',
        'Options:',
        '--trace => show exception stack when execute a command',
        '',
        'Run app/ice COMMAND --help for more information'
    );
}
$app->terminate();
exit($exitCode);
