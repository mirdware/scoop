$color-main ?= var(--primary)
$color-strong ?= unquote('color-mix(in srgb, var(--primary) 85%, var(--on-surface))')
$color-check ?= var(--secondary)
$color-contrast ?= var(--on-primary)
$color-blue-main ?= var(--info)
$color-blue-strong ?= unquote('color-mix(in srgb, var(--info) 85%, var(--on-surface))')
$color-red-main ?= var(--error)
$color-red-strong ?= unquote('color-mix(in srgb, var(--error) 85%, var(--on-surface))')
$color-green-main ?= var(--success)
$color-green-strong ?= unquote('color-mix(in srgb, var(--success) 85%, var(--on-surface))')
$color-orange-main ?= var(--primary)
$color-orange-strong ?= unquote('color-mix(in srgb, var(--primary) 85%, var(--on-surface))')
$color-yellow-main ?= var(--warning)
$color-yellow-strong ?= unquote('color-mix(in srgb, var(--warning) 85%, var(--on-surface))')
$color-gray-main ?= unquote('color-mix(in srgb, var(--on-surface) 70%, var(--surface))')
$color-gray-strong ?= var(--on-surface)
$color-border-text ?= var(--outline)
$color-bg-success ?= unquote('color-mix(in srgb, var(--success) 15%, var(--surface))')
$color-bg-info ?= unquote('color-mix(in srgb, var(--info) 15%, var(--surface))')
$color-bg-warning ?= unquote('color-mix(in srgb, var(--warning) 15%, var(--surface))')
$color-bg-error ?= unquote('color-mix(in srgb, var(--error) 15%, var(--surface))')
$color-bg-disabled ?= unquote('color-mix(in srgb, var(--surface) 92%, var(--on-surface))')
