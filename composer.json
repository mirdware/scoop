{
    "name": "mirdware/scoop",
    "description": "Simple Components of Object-Oriented Programming",
    "keywords": ["scoop", "ddd", "hexagonal", "cqrs", "onion", "engine"],
    "license": "MIT",
    "type": "project",
    "homepage": "http://getscoop.org",
    "authors": [
        {
            "name": "Marlon Ramírez",
            "email": "marlonramirez@outlook.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Scoop\\": "scoop/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^5.4|^7.0|^8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^13.2",
        "zircote/swagger-php": "^6.5",
        "phpat/phpat": "^0.12.4",
        "phpstan/extension-installer": "^1.4",
        "veewee/composer-run-parallel": "^1.5"
    },
    "scripts": {
        "build": [
            "@php app/ice scan source",
            "@php app/ice scan routes",
            "@php app/ice preload json:package",
            "@php app/ice preload json:composer"
        ],
        "test:lint": "./vendor/bin/phpcs -p ./src --standard=app/phpcs.xml",
        "test:static": "./vendor/bin/phpstan --configuration=app/phpstan.neon",
        "test:unit" : "./vendor/bin/phpunit --configuration=app/phpunit.xml --testsuite=application",
        "test:scoop" : "./vendor/bin/phpunit --configuration=app/phpunit.xml --testsuite=scoop",
        "test": "@parallel test:lint test:static test:unit",
        "fix:lint": "./vendor/bin/phpcbf --standard=app/phpcs.xml -p",
        "fix": "@fix:lint ./src",
        "api": "./vendor/bin/openapi src -o openapi.yaml"
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "veewee/composer-run-parallel": true
        }
    }
}
